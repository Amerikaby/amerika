# 301-редиректы со старого WordPress на новый сайт (для переезда в корень amerika.by).
# Сгенерировано 2026-10-15 скриптом site/build.mjs из XML-карт старого сайта (1883 адресов).
# В new2/ НЕ подключается. При переезде вставить в .htaccess корня ПЕРЕД правилами сайта.
# Адреса, которые на новом сайте сохранены (каталог /auto-usa/, марки /usa/<марка>/, блог, услуги, цены,
# контакты, отзывы, таможенный калькулятор, политика), здесь не перечислены: они открываются как есть.
# Всего правил: 501.
<IfModule mod_rewrite.c>
RewriteEngine On
# тестовый каталог
RewriteRule ^auctions/?$ /auto-usa/ [R=301,L,NE]
# раздел не из США → каталог США
RewriteRule ^auto-canada/?$ /auto-usa/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/acura-tlx-a-spec-2020/?$ /usa/acura/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/audi-e-tron-premium-2021/?$ /usa/audi/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/audi-e-tron-premium-plus-2022/?$ /usa/audi/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/audi-e-tron-prestige-2021/?$ /usa/audi/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/audi-q3-premium-plus-2020/?$ /usa/audi/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/audi-q5-premium-2020/?$ /usa/audi/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/chevrolet-cruze-lt-2018/?$ /usa/chevrolet/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/chevrolet-equinox-lt-2022/?$ /usa/chevrolet/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/chevrolet-equinox-lt-2023/?$ /usa/chevrolet/ [R=301,L,NE]
# электромобили не из США → электромобили из США
RewriteRule ^auto-canada/elektromobily-canada/?$ /auto-usa/elektromobily-usa/ [R=301,L,NE]
# машина не из США → марка или каталог США
RewriteRule ^auto-canada/ford-mustang-mach-e-premium-2022/?$ /usa/ford/ [R=301,L,NE]
